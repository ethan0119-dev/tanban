[Unit]
Description=Tanban official website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/tanban/current
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/srv/tanban/current/node_modules/.bin/vinext start --port 18100 --hostname 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/tanban/website-releases /var/cache/tanban/website-build
UMask=0027

[Install]
WantedBy=multi-user.target
