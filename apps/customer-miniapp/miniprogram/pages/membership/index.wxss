.membership-page { min-height: 100vh; padding: 28rpx 26rpx 70rpx; box-sizing: border-box; background: var(--paper); }
.member-hero { display: flex; min-height: 280rpx; flex-direction: column; gap: 14rpx; padding: 36rpx; border-radius: var(--radius); box-sizing: border-box; color: var(--on-primary); background: var(--green); box-shadow: var(--card-shadow); }
.member-hero > text:first-child { color: rgba(255,255,255,.75); font-size: 25rpx; }
.member-hero .level-name { font-size: 44rpx; font-weight: var(--font-weight-strong); }
.member-hero > text:nth-child(3) { color: rgba(255,255,255,.72); font-size: 22rpx; }
.balance-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: auto; padding-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.22); }
.balance-row > view { display: flex; flex-direction: column; gap: 5rpx; }
.balance-row > view text:first-child { color: rgba(255,255,255,.72); font-size: 22rpx; }
.balance-row > view text:last-child { font-size: 36rpx; font-weight: var(--font-weight-semibold); }
.balance-row button { min-width: 146rpx; height: 58rpx; margin: 0; padding: 0 20rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); color: #fff; font-size: 24rpx; line-height: 58rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 42rpx 4rpx 20rpx; }
.section-heading text:first-child { font-size: var(--font-title); font-weight: var(--font-weight-semibold); }
.section-heading text:last-child { color: var(--muted); font-size: 22rpx; }
.level-list { display: flex; flex-direction: column; gap: 20rpx; }
.level-card { padding: 28rpx; border: 2rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--card-shadow); }
.level-card.current { border-color: var(--green); }
.level-main { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.level-main > view { display: flex; flex-direction: column; gap: 8rpx; }
.level-main > view text:first-child { color: var(--ink); font-size: 34rpx; font-weight: var(--font-weight-semibold); }
.level-main > view text:last-child { color: var(--green); font-size: 23rpx; }
.level-main > text { color: var(--coffee); font-size: 30rpx; font-weight: var(--font-weight-strong); }
.level-benefits { display: flex; flex-direction: column; gap: 8rpx; margin-top: 22rpx; color: var(--muted); font-size: 23rpx; }
.level-card button { margin-top: 24rpx; border-radius: var(--button-radius); background: var(--green); color: var(--on-primary); font-size: 27rpx; }
.level-card button[disabled] { color: var(--green); background: var(--soft-primary); }
.member-note { display: flex; flex-direction: column; gap: 12rpx; margin-top: 26rpx; padding: 26rpx; border-radius: var(--radius); background: var(--surface); }
.member-note text:first-child { font-size: 28rpx; font-weight: var(--font-weight-semibold); }
.member-note text:last-child { color: var(--muted); font-size: 23rpx; line-height: 1.7; }
