.success, .payment-waiting { display: flex; flex-direction: column; align-items: center; padding-top: 45rpx; }
.check { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--green); color: var(--on-primary); font-size: 56rpx; }
.payment-waiting .check { background: var(--lime); color: var(--on-accent); }
.status-title { margin-top: 22rpx; font-size: 40rpx; font-weight: var(--font-weight-semibold); }
.success .muted, .payment-waiting .muted { margin-top: 10rpx; font-size: 25rpx; text-align: center; }
.pickup { display: flex; width: 100%; flex-direction: column; align-items: center; margin-top: 36rpx; padding: 30rpx 0; border-radius: 22rpx; background: var(--cream); }
.pickup text:last-child { margin-top: 6rpx; font-family: Georgia, serif; font-size: 82rpx; font-weight: var(--font-weight-strong); }
.table-destination { display: flex; width: 100%; flex-direction: column; align-items: center; gap: 7rpx; margin-top: 36rpx; padding: 28rpx 0; border-radius: var(--radius); background: var(--paper); }
.table-destination text:first-child { color: var(--green); font-size: 24rpx; font-weight: var(--font-weight-semibold); }
.table-destination text:nth-child(2) { font-size: 48rpx; font-weight: var(--font-weight-strong); }
.table-destination text:last-child { color: var(--muted); font-size: 24rpx; }
.detail-line { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 24rpx; }
.detail-line text:last-child { max-width: 65%; color: var(--ink); text-align: right; }
.items-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid var(--line); }
.items-heading text:first-child { font-size: 30rpx; font-weight: var(--font-weight-semibold); }
.items-heading text:last-child { color: var(--green); font-size: 21rpx; }
.order-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.order-item:last-child { border-bottom: 0; }
.order-item > view { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }
.order-item > text { flex-shrink: 0; font-weight: var(--font-weight-semibold); }
.member-saving { color: var(--green) !important; font-size: 21rpx; font-weight: var(--font-weight-semibold); }
.order-actions { display: flex; flex-direction: column; gap: 16rpx; margin: 32rpx 28rpx; }
.order-actions button { margin: 0; }
.pay-button { font-size: 30rpx; }
.secondary { border: 1rpx solid var(--green); background: var(--surface); color: var(--green); }
