<view class="page" style="{{appearanceStyle}}" wx:if="{{order}}">
  <view class="{{order.paymentSucceeded ? 'success' : 'payment-waiting'}} card"><view class="check">{{order.paymentSucceeded ? '✓' : '…'}}</view><text class="status-title">{{order.statusTitle}}</text><text class="muted">{{order.paymentSucceeded && order.isDineIn ? '商家已收到订单，请在当前桌台等候' : order.statusMessage}}</text><view class="table-destination" wx:if="{{order.isDineIn}}"><text>堂食桌台</text><text>{{order.displayTableName}}</text><text wx:if="{{order.displayTableArea || order.displayTableCode}}">{{order.displayTableArea}}{{order.displayTableArea && order.displayTableCode ? ' · ' : ''}}{{order.displayTableCode}}</text></view><view class="pickup" wx:else><text>取餐号</text><text>{{order.pickupCode || '--'}}</text></view></view>
  <view class="card order-items" wx:if="{{order.items && order.items.length}}"><view class="items-heading"><text>点单明细</text><text>{{order.additionCount > 1 ? '已加菜 ' + (order.additionCount - 1) + ' 次' : '首次点单'}}</text></view><view class="order-item" wx:for="{{order.items}}" wx:key="id"><view><text>{{item.name}} × {{item.quantity}}</text><text class="muted">{{item.skuName || item.optionSummary || '默认规格'}}{{item.additionSequence > 1 ? ' · 加菜 #' + (item.additionSequence - 1) : ''}}</text><view class="member-saving" wx:if="{{item.memberDiscount}}">会员已省 ¥{{item.memberDiscount / 100}}</view></view><text>¥{{item.amount / 100}}</text></view></view>
  <view class="card"><view class="detail-line"><text>订单号</text><text>{{order.orderNo}}</text></view><view class="detail-line"><text>就餐方式</text><text>{{order.isDineIn ? '堂食 · ' + order.displayTableName : '门店自取'}}</text></view><view class="detail-line" wx:if="{{order.isDineIn && order.dinerCount}}"><text>就餐人数</text><text>{{order.dinerCount}} 人</text></view><view class="detail-line"><text>订单状态</text><text class="status">{{order.orderStatusText}}</text></view><view class="detail-line"><text>支付状态</text><text>{{order.paymentStatusText}}</text></view><view class="detail-line" wx:if="{{order.memberLevelName}}"><text>会员等级</text><text>{{order.memberLevelName}}</text></view><view class="detail-line" wx:if="{{order.memberDiscount}}"><text>会员优惠</text><text class="member-saving">−¥{{order.memberDiscount / 100}}</text></view><view class="detail-line" wx:if="{{order.paidAmount}}"><text>已收金额</text><text>¥{{order.paidAmount / 100}}</text></view><view class="detail-line"><text>{{order.payAfterMeal && !order.paymentSucceeded ? '待结账金额' : '订单金额'}}</text><text class="price">¥{{(order.payAfterMeal && !order.paymentSucceeded ? order.remainingAmount : order.amount) / 100}}</text></view><view class="detail-line"><text>下单时间</text><text>{{order.createdAt}}</text></view></view>
  <view class="order-actions" wx:if="{{order.canPay || order.canAddItems}}"><button class="primary pay-button" loading="{{paying}}" disabled="{{paying}}" wx:if="{{order.canPay}}" bindtap="payOrder">立即支付 ¥{{order.remainingAmount / 100}}</button><button class="{{order.canPay ? 'secondary' : 'primary'}} back" wx:if="{{order.canAddItems}}" bindtap="backToMenu">继续加菜</button></view>
</view><view class="empty" wx:else>正在确认订单状态…</view>
<marketing-popup appearance-style="{{appearanceStyle}}" wx:if="{{order}}" store-code="{{storeCode}}" placement-code="ORDER_RESULT_POPUP" channel-scope="{{order.isDineIn ? 'DINE_IN' : 'TAKEOUT'}}" />
